SERVICE_NAME=o11yag_orchestrator
ENV=local
PORT=8000

LITELLM_URL=http://localhost:4000/v1
LITELLM_KEY=not-needed-locally
CHAT_MODEL=support-chat

KNOWLEDGE_URL=http://localhost:8001
ACTION_URL=http://localhost:8002
WORKER_TIMEOUT_S=300

OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OpenLLMetry captures prompts/completions onto spans by default. We keep them
# off spans and put them in the audit records instead.
TRACELOOP_TRACE_CONTENT=false

COST_PER_1K_TOKENS_USD=0.0002
AUDIT_LOG_CONTENT=true
AUDIT_MAX_TEXT_CHARS=2000
