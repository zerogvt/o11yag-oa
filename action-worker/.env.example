SERVICE_NAME=o11yag_action_worker
ENV=local
PORT=8002

LITELLM_URL=http://localhost:4000/v1
LITELLM_KEY=not-needed-locally
CHAT_MODEL=support-chat

MCP_URL=http://localhost:8003/mcp
MCP_TIMEOUT_S=60

APPROVALS_URL=http://localhost:8004
APPROVAL_TIMEOUT_S=180
APPROVAL_POLL_S=2

# model | rules  — see config.py. Use rules for a demo that must reach the
# approval gate regardless of how bad the local model is.
PLANNER_MODE=model
MAX_STEPS=4
CONSEQUENTIAL_TOOLS=issue_refund

OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
TRACELOOP_TRACE_CONTENT=false
